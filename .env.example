# Nothing is asked for on deploy.
#
# Set by the Blueprint: FUSION_PORT, FUSION_DB_PATH, FUSION_PASSWORD (generated).
#
# Optional, add on the fusion service after deploy:
# FUSION_PULL_INTERVAL=1800        # seconds between feed refreshes
# FUSION_FEVER_USERNAME=fusion     # Fever API username
# FUSION_OIDC_ISSUER=              # SSO; also set CLIENT_ID, CLIENT_SECRET, REDIRECT_URI
# FUSION_OIDC_CLIENT_ID=
# FUSION_OIDC_CLIENT_SECRET=
# FUSION_OIDC_REDIRECT_URI=https://<fusion>.onrender.com/api/oidc/callback
# FUSION_OIDC_ALLOWED_USER=
